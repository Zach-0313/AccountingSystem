{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "applicationdomainproject/src/**/*"  // Include the src folder inside the correct directory
  ],
  "exclude": [
    "node_modules"
  ]
}